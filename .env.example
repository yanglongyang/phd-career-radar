# PhD Career Radar — 环境变量示例
# 复制为 .env 并填写。所有 AI 相关配置只在运行时读取，不写入代码。

# ---- AI Provider（OpenAI-compatible API）----
# 留空则系统以"未配置 AI"模式运行：手工功能全部可用，AI 解析/评估返回明确错误，不伪造结果
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# ---- 数据库（默认 SQLite，存放在 data/ 下；留空使用默认值）----
# DATABASE_URL=sqlite:///F:/phd-career-radar/data/phd_career_radar.db

# ---- CORS（前端开发服务器地址，JSON 数组格式）----
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
